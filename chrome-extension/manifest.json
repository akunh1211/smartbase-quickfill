{
  "manifest_version": 3,
  "name": "SmartBase מילוי מהיר לכרטיס עבודה",
  "version": "1.0.0",
  "description": "מילוי מהיר של כרטיסי עבודה ב-SmartBase: מסלולים קבועים עם עריכת עצירה, מטרות מועדפות, רכבים, זיכרון ק\"מ ות\"ז קבועה.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://smartbase.digital.idf.il/*",
        "*://*.smartbase.digital.idf.il/*",
        "*://*/*smartbase*",
        "file:///*smartbase*.html"
      ],
      "js": [
        "smartbase-quickfill.user.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
